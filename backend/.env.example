PORT=8080
CLIENT_URL=http://localhost:5173
JWT_SECRET=super-secret-live-polling-key-2026-secure

# MongoDB connection string (e.g. MongoDB Atlas free cluster: mongodb+srv://<user>:<password>@cluster.mongodb.net/livepolling?retryWrites=true&w=majority)
# Leave blank to use in-memory engine during quick offline development
MONGO_URI=
MONGO_DB_NAME=livepolling

# Redis connection string (e.g. Upstash Redis or Redis Cloud: rediss://default:<password>@<host>:<port> or localhost:6379)
# Leave blank to use in-memory engine during quick offline development
REDIS_URL=
REDIS_ADDR=
REDIS_PASSWORD=
